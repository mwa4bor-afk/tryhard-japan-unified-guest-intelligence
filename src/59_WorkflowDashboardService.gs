TGI.WorkflowDashboardService = (function () {
  var SHEET='Workflow_Dashboard';
  function rebuild(){TGI.AccessControlService.requirePermission('workflows.view');var events=TGI.DomainEventService.all(),rules=TGI.WorkflowRuleService.all(),executions=TGI.WorkflowEngineService.executions(),summary={pending:0,retry:0,processed:0,active_rules:0,completed_executions:0,failed_executions:0};events.forEach(function(e){summary[String(e.status||'').toLowerCase()] = (summary[String(e.status||'').toLowerCase()]||0)+1;});summary.active_rules=rules.filter(function(r){return r.status==='ACTIVE';}).length;executions.forEach(function(x){if(x.status==='COMPLETED')summary.completed_executions++;if(x.status==='FAILED')summary.failed_executions++;});var ss=SpreadsheetApp.getActiveSpreadsheet(),sheet=ss.getSheetByName(SHEET)||ss.insertSheet(SHEET);sheet.clear();var rows=[['TRYHARD WORKFLOW OPERATIONS',''],['Generated',new Date()],['Pending events',summary.pending||0],['Retry events',summary.retry||0],['Processed events',summary.processed||0],['Active rules',summary.active_rules],['Completed executions',summary.completed_executions],['Failed executions',summary.failed_executions],['',''],['RULE','EVENT TYPE','ACTION','STATUS','PRIORITY']];rules.sort(function(a,b){return Number(a.priority||100)-Number(b.priority||100);}).forEach(function(r){rows.push([r.name,r.event_type,r.action_type,r.status,r.priority]);});sheet.getRange(1,1,rows.length,5).setValues(rows.map(function(r){return [r[0]||'',r[1]===undefined?'':r[1],r[2]===undefined?'':r[2],r[3]===undefined?'':r[3],r[4]===undefined?'':r[4]];}));sheet.setFrozenRows(1);sheet.autoResizeColumns(1,5);TGI.AuditLog.write(SHEET,'WORKFLOWS','REBUILD',summary);return summary;}
  return {rebuild:rebuild};
})();
